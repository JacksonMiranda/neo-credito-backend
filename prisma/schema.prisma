generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CORBAN
  OPERADOR
}

enum PropostaStatus {
  RASCUNHO
  EM_ANALISE
  APROVADA
  REPROVADA
  CANCELADA
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  propostas    Proposta[] @relation("CorbanPropostas")

  @@map("users")
}

model Proposta {
  id               String         @id @default(uuid())
  clienteNome      String
  clienteCpf       String
  clienteRenda     Decimal        @db.Decimal(12, 2)
  valorSolicitado  Decimal        @db.Decimal(12, 2)
  numeroParcelas   Int
  taxaMensal       Decimal        @db.Decimal(5, 2)
  valorParcela     Decimal        @db.Decimal(12, 2)
  totalAPagar      Decimal        @db.Decimal(12, 2)
  status           PropostaStatus @default(RASCUNHO)
  motivoReprovacao String?
  corbanId         String
  corban           User           @relation("CorbanPropostas", fields: [corbanId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([corbanId])
  @@index([status])
  @@map("propostas")
}
